APP_ACCOUNTS_JSON={"shawn":{"pin":"CHANGE_ME","role":"Manager"},"keith":{"pin":"CHANGE_ME","role":"Owner"},"herlyn":{"pin":"CHANGE_ME","role":"Office"},"diego":{"pin":"CHANGE_ME","role":"Staff"},"mark":{"pin":"CHANGE_ME","role":"Staff"}}
